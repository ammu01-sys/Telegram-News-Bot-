# Supabase project URL and anon/public API key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token

# Gemini AI API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenRouter API key (fallback if Gemini fails)
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: Proxy for Telegram API (if blocked in your country)
# Supports http, https, socks5 (e.g. socks5://127.0.0.1:1080)
TELEGRAM_PROXY=

# Pipeline interval in minutes (default: 60)
SCRAPE_INTERVAL_MINUTES=60

# Max retry attempts for API calls (default: 3)
MAX_RETRY_ATTEMPTS=3

# Set to 1 to disable AI rephrasing (uses raw article content)
DISABLE_REPHRASE=0
